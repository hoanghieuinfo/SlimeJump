<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:background="@color/slime_blue_primary">

    <TextView
        android:id="@+id/tvLogNo"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textColor="@color/gold"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/tvLogTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slime_text_hint"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/tvLogScreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slime_text"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvLogUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slime_accent"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvLogManager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
